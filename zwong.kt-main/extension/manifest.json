{
  "manifest_version": 3,
  "name": "TaxCap Suite — Tải HĐĐT, Hồ sơ thuế & Captcha",
  "short_name": "TaxCap Suite",
  "version": "2.1.0",
  "description": "Bộ công cụ kế toán hợp nhất trên Side Panel: Tải hóa đơn điện tử hàng loạt (Excel/XML/HTML/PDF), Tải hồ sơ khai thuế DVC & Thuế ĐT và Tự điền Captcha cục bộ (SVG + ONNX) cho 46 cổng Thuế, BHXH, Hải quan, Ngân hàng & NCC Hóa đơn.",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "downloads",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://hoadondientu.gdt.gov.vn/*",
    "https://tracuunnt.gdt.gov.vn/*",
    "https://thuedientu.gdt.gov.vn/*",
    "https://dichvucong.gdt.gov.vn/*",
    "https://baohiemxahoi.gov.vn/*",
    "https://dichvucong.baohiemxahoi.gov.vn/*",
    "https://customs.gov.vn/*",
    "https://www.customs.gov.vn/*",
    "https://epayment.customs.gov.vn/*",
    "https://bhxh.vnpost.vn/*",
    "https://congkhaithongtin.gdt.gov.vn/*",
    "https://gdt.gov.vn/*",
    "https://www.gdt.gov.vn/*",
    "https://canhan.gdt.gov.vn/*",
    "https://vpcp.dichvucong.gov.vn/*",
    "https://hst.vnpt-invoice.com.vn/*",
    "https://hddt.thegioididong.com/*",
    "https://hddt.bachhoaxanh.com/*",
    "https://hoadondientu.thaco.com.vn/*",
    "https://hoadon.pvoil.vn/*",
    "https://einvoice78.suntorypepsico.vn/*",
    "https://invoice.idemitsuq8.com.vn/*",
    "https://tracuu.vinvoice.vn/*",
    "https://einvoice.bidv.com.vn/*",
    "https://hoadondientu.ezrx.com.vn/*",
    "https://e-invoice-tt78.vingroup.net/*",
    "https://hoadon.petrolimex.com.vn/*",
    "https://abcsys.vn/*",
    "https://tracuuhd.smartsign.com.vn/*",
    "https://spv.tracuuhoadon.online/*",
    "https://einvoice.vn/*",
    "https://tracuu.v50.vninvoice.vn/*",
    "https://tracuuonline78.ngogiaphat.vn/*",
    "https://*.vnpt-invoice.com.vn/*",
    "https://vdsg-invoice.vn/*",
    "https://hoadon.ftg.vn/*",
    "https://einvoice.vietcombank.com.vn/*",
    "https://tracuuhoadon.pgbank.com.vn/*",
    "https://ncb-bank.vn/*",
    "https://www.ncb-bank.vn/*",
    "https://hoadondientu.techcombank.com.vn/*",
    "https://hoadondientu.agribank.com.vn/*",
    "https://einvoice.abbank.vn/*",
    "https://einvoice.publicbank.com.vn/*",
    "https://einvoice.eximbank.com.vn/*",
    "https://einvoice.lpbank.com.vn/*",
    "https://einvoice.msb.com.vn/*",
    "https://portal.woori.com.vn/*",
    "https://einvoice.vpbank.com.vn/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TaxCap Suite — Tải HĐĐT, Hồ sơ thuế & Captcha",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hoadondientu.gdt.gov.vn/*"],
      "js": [
        "content/captcha-svg-templates.js",
        "content/captcha-svg.js",
        "content/bang_svg.js",
        "content/giai_svg.js",
        "content/common.js",
        "content/hddt.js",
        "content/hddt/zip.js",
        "content/hddt/xlsx.js",
        "content/hddt/hddt-api.js",
        "content/hddt/report.js",
        "content/hddt/pdf.js",
        "content/hddt/hddt-content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://dichvucong.gdt.gov.vn/*"],
      "js": [
        "content/common.js",
        "content/dvc.js",
        "content/hoso/gdt-api.js",
        "content/hoso/hoso-content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://thuedientu.gdt.gov.vn/*"],
      "js": [
        "content/common.js",
        "content/tdt.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://tracuunnt.gdt.gov.vn/*"],
      "js": [
        "content/common.js",
        "content/tracuunnt.js"
      ],
      "run_at": "document_end"
    },
    {
      "all_frames": true,
      "matches": [
        "https://baohiemxahoi.gov.vn/*",
        "https://dichvucong.baohiemxahoi.gov.vn/*",
        "https://customs.gov.vn/*",
        "https://www.customs.gov.vn/*",
        "https://epayment.customs.gov.vn/*",
        "https://bhxh.vnpost.vn/*",
        "https://congkhaithongtin.gdt.gov.vn/*",
        "https://gdt.gov.vn/*",
        "https://www.gdt.gov.vn/*",
        "https://canhan.gdt.gov.vn/*",
        "https://vpcp.dichvucong.gov.vn/*",
        "https://hst.vnpt-invoice.com.vn/*",
        "https://hddt.thegioididong.com/*",
        "https://hddt.bachhoaxanh.com/*",
        "https://hoadondientu.thaco.com.vn/*",
        "https://hoadon.pvoil.vn/*",
        "https://einvoice78.suntorypepsico.vn/*",
        "https://invoice.idemitsuq8.com.vn/*",
        "https://tracuu.vinvoice.vn/*",
        "https://einvoice.bidv.com.vn/*",
        "https://hoadondientu.ezrx.com.vn/*",
        "https://e-invoice-tt78.vingroup.net/*",
        "https://hoadon.petrolimex.com.vn/*",
        "https://abcsys.vn/*",
        "https://tracuuhd.smartsign.com.vn/*",
        "https://spv.tracuuhoadon.online/*",
        "https://einvoice.vn/*",
        "https://tracuu.v50.vninvoice.vn/*",
        "https://tracuuonline78.ngogiaphat.vn/*",
        "https://*.vnpt-invoice.com.vn/*",
        "https://vdsg-invoice.vn/*",
        "https://hoadon.ftg.vn/*",
        "https://einvoice.vietcombank.com.vn/*",
        "https://tracuuhoadon.pgbank.com.vn/*",
        "https://ncb-bank.vn/*",
        "https://www.ncb-bank.vn/*",
        "https://hoadondientu.techcombank.com.vn/*",
        "https://hoadondientu.agribank.com.vn/*",
        "https://einvoice.abbank.vn/*",
        "https://einvoice.publicbank.com.vn/*",
        "https://einvoice.eximbank.com.vn/*",
        "https://einvoice.lpbank.com.vn/*",
        "https://einvoice.msb.com.vn/*",
        "https://portal.woori.com.vn/*",
        "https://einvoice.vpbank.com.vn/*"
      ],
      "js": [
        "content/cau_hinh_cong.js",
        "content/common.js",
        "content/extended-portals.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["https://hoadondientu.gdt.gov.vn/*"],
      "resources": ["content/fonts/*.ttf"]
    }
  ]
}
