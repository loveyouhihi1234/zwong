{
  "manifest_version": 3,
  "name": "CVTax – Tự động giải captcha",
  "version": "2.0.0",
  "description": "Tự động giải và điền ô captcha cục bộ trên cổng Thuế, BHXH, Hải quan, Dịch vụ công và tra cứu hóa đơn. Không cần đăng nhập.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
